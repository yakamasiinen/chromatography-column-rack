    given-names: Yu
    affiliation: "Department of Chemistry, Graduate School of Science, The University of Osaka"
    alias: yakamasiinen
version: "1.0"
date-released: "2026-10-14"
license: MIT
repository-code: "https://github.com/yakamasiinen/column-rack"
keywords:
  - 3d-printing
  - lab-equipment
  - chromatography
  - column-rack
  - open-hardware
